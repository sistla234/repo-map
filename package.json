{
  "name": "repo-map",
  "version": "0.1.0",
  "description": "A visual map of your git repo: branches, PRs and screens as a graph, with safe push/pull/rebase that shows the raw git command.",
  "license": "MIT",
  "keywords": [
    "git",
    "github",
    "visualization",
    "branches",
    "pull-requests",
    "screenshots",
    "visual-diff",
    "claude-code",
    "skill",
    "ai-agents"
  ],
  "homepage": "https://github.com/sistla234/repo-map#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sistla234/repo-map.git"
  },
  "bugs": {
    "url": "https://github.com/sistla234/repo-map/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "bin": {
    "repo-map": "bin/repo-map.js"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "node bin/repo-map.js",
    "test": "node test/capture.test.mjs",
    "prepare": "vite build"
  },
  "dependencies": {
    "express": "^4.19.2",
    "pixelmatch": "^8.0.0",
    "playwright-core": "^1.64.1",
    "pngjs": "^7.0.0",
    "simple-git": "^3.25.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.0"
  }
}
